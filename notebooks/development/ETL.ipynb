    "def get_channel_upload_playlist(youtube, channel_id: str) -> Optional[str]:\n",
    "    \"\"\"\n",
    "    Get the uploads playlist ID for a YouTube channel.\n",
    "    \n",
    "    Args:\n",
    "        youtube: YouTube API client\n",
    "        channel_id: YouTube channel ID or handle\n",
    "    \n",
    "    Returns:\n",
    "        str: Upload playlist ID or None if not found\n",
    "    \"\"\"\n",
    "    try:\n",
    "        # Handle both channel IDs and handles\n",
    "        if channel_id.startswith('@'):\n",
    "            # For handles, we need to get the channel ID first\n",
    "            search_response = safe_execute(\n",
    "                youtube.search().list(\n",
    "                    q=channel_id,\n",
    "                    type='channel',\n",
    "                    part='id',\n",
    "                    maxResults=1\n",
    "                )\n",
    "            )\n",
    "            \n",
    "            if search_response.get('items'):\n",
    "                channel_id = search_response['items'][0]['id']['channelId']\n",
    "                logger.info(f\"Resolved handle {channel_id} to channel ID {channel_id}\")\n",
    "            else:\n",
    "                logger.error(f\"Could not resolve channel handle: {channel_id}\")\n",
    "                return None\n",
    "        \n",
    "        # Get channel details including uploads playlist\n",
    "        channel_response = safe_execute(\n",
    "            youtube.channels().list(\n",
    "                id=channel_id,\n",
    "                part='contentDetails,statistics,snippet',\n",
    "                maxResults=1\n",
    "            )\n",
    "        )\n",
    "        \n",
    "        if channel_response.get('items'):\n",
    "            channel_data = channel_response['items'][0]\n",
    "            uploads_playlist = channel_data.get('contentDetails', {}).get('relatedPlaylists', {}).get('uploads')\n",
    "            \n",
    "            if uploads_playlist:\n",
    "                logger.info(f\"Found uploads playlist for channel {channel_id}: {uploads_playlist}\")\n",
    "                return uploads_playlist\n",
    "            else:\n",
    "                logger.warning(f\"No uploads playlist found for channel {channel_id}\")\n",
    "                return None\n",
    "        else:\n",
    "            logger.error(f\"Channel not found: {channel_id}\")\n",
    "            return None\n",
    "            \n",
    "    except HttpError as e:\n",
    "        logger.error(f\"Error getting uploads playlist for channel {channel_id}: {e}\")\n",
    "        return None\n",
    "    except Exception as e:\n",
    "        logger.error(f\"Unexpected error getting uploads playlist: {e}\")\n",
    "        return None\n",
    "\n",
    "def get_channel_videos(youtube, channel_id: str, max_videos: int = 50) -> List[Dict[str, Any]]:\n",
    "    \"\"\"\n",
    "    Get videos from a YouTube channel's uploads playlist.\n",
    "    \n",
    "    Args:\n",
    "        youtube: YouTube API client\n",
    "        channel_id: YouTube channel ID or handle\n",
    "        max_videos: Maximum number of videos to retrieve\n",
    "    \n",
    "    Returns:\n",
    "        List[Dict]: List of video items with metadata\n",
    "    \"\"\"\n",
    "    # Get uploads playlist ID\n",
    "    uploads_playlist = get_channel_upload_playlist(youtube, channel_id)\n",
    "    if not uploads_playlist:\n",
    "        return []\n",
    "    \n",
    "    # Get videos from the uploads playlist\n",
    "    try:\n",
    "        videos = get_playlist_videos(\n",
    "            youtube=youtube,\n",
    "            playlist_id=uploads_playlist,\n",
    "            max_videos=max_videos,\n",
    "            offset=0,\n",
    "            engine=None,  # We'll handle storage separately\n",
    "            development_mode=CONFIG['development_mode'],\n",
    "            cache_threshold_hours=CONFIG['cache_threshold_hours']\n",
    "        )\n",
    "        \n",
    "        logger.info(f\"Retrieved {len(videos)} videos from channel {channel_id}\")\n",
    "        return videos\n",
    "        \n",
    "    except Exception as e:\n",
    "        logger.error(f\"Error getting videos from channel {channel_id}: {e}\")\n",
    "        return []\n",
    "\n",
    "def get_video_statistics(youtube, video_ids: List[str]) -> List[Dict[str, Any]]:\n",
    "    \"\"\"\n",
    "    Get detailed statistics for a list of YouTube videos.\n",
    "    \n",
    "    Args:\n",
    "        youtube: YouTube API client\n",
    "        video_ids: List of YouTube video IDs\n",
    "    \n",
    "    Returns:\n",
    "        List[Dict]: List of video details with statistics\n",
    "    \"\"\"\n",
    "    if not video_ids:\n",
    "        return []\n",
    "    \n",
    "    try:\n",
    "        videos_data = get_video_details(\n",
    "            youtube=youtube,\n",
    "            video_ids=video_ids,\n",
    "            max_retries=CONFIG['max_retries'],\n",
    "            engine=None  # We'll handle storage separately\n",
    "        )\n",
    "        \n",
    "        logger.info(f\"Retrieved statistics for {len(videos_data)} videos\")\n",
    "        return videos_data\n",
    "        \n",
    "    except Exception as e:\n",
    "        logger.error(f\"Error getting video statistics: {e}\")\n",
    "        return []\n",
    "\n",
    "print(\"✅ YouTube API functions defined!\")"
   ]
