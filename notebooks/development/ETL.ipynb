   "source": [
    "def store_video_data(engine, video_metadata: Dict[str, Any]) -> None:\n",
    "    \"\"\"\n",
    "    Store video data in the database.\n",
    "    \n",
    "    Args:\n",
    "        engine: SQLAlchemy engine\n",
    "        video_metadata: Processed video metadata\n",
    "    \"\"\"\n",
    "    try:\n",
    "        with engine.begin() as conn:\n",
    "            # Get table references\n",
    "            youtube_videos_tbl = get_table('youtube_videos')\n",
    "            youtube_metrics_tbl = get_table('youtube_metrics')\n",
    "            \n",
    "            # Prepare data for youtube_videos table\n",
    "            video_record = {\n",
    "                'video_id': video_metadata['video_id'],\n",
    "                'title': video_metadata['title'],\n",
    "                'channel_title': video_metadata['channel_title'],\n",
    "                'published_at': video_metadata['published_at'],\n",
    "                'duration': video_metadata['duration'],\n",
    "                'view_count': video_metadata['view_count'],\n",
    "                'like_count': video_metadata['like_count'],\n",
    "                'comment_count': video_metadata['comment_count'],\n",
    "                'dsp_name': 'YouTube',\n",
    "                'fetched_at': video_metadata['fetched_at']\n",
    "            }\n",
    "            \n",
    "            # Remove None values for cleaner storage\n",
    "            video_record = {k: v for k, v in video_record.items() if v is not None}\n",
    "            \n",
    "            # Insert/update youtube_videos record\n",
    "            stmt = mysql_insert(youtube_videos_tbl).values(video_record)\n",
    "            stmt = stmt.on_duplicate_key_update(**{\n",
    "                col: stmt.inserted[col] \n",
    "                for col in video_record \n",
    "                if col != 'video_id'\n",
    "            })\n",
    "            conn.execute(stmt)\n",
    "            \n",
    "            # Prepare data for youtube_metrics table\n",
    "            metrics_record = {\n",
    "                'video_id': video_metadata['video_id'],\n",
    "                'view_count': video_metadata['view_count'],\n",
    "                'like_count': video_metadata['like_count'],\n",
    "                'comment_count': video_metadata['comment_count'],\n",
    "                'metrics_date': video_metadata['fetched_at'].date(),\n",
    "                'fetched_at': video_metadata['fetched_at']\n",
    "            }\n",
    "            \n",
    "            # Insert metrics record\n",
    "            stmt = mysql_insert(youtube_metrics_tbl).values(metrics_record)\n",
    "            stmt = stmt.on_duplicate_key_update(**{\n",
    "                col: stmt.inserted[col] \n",
    "                for col in metrics_record \n",
    "                if col not in ['video_id', 'metrics_date']\n",
    "            })\n",
    "            conn.execute(stmt)\n",
    "            \n",
    "            logger.debug(f\"Stored data for video {video_metadata['video_id']}\")\n",
    "            \n",
    "    except Exception as e:\n",
    "        logger.error(f\"Error storing video data: {e}\")\n",
    "        raise\n",
    "\n",
    "def store_artist_data(engine, artist_results: Dict[str, Any]) -> None:\n",
    "    \"\"\"\n",
    "    Store all artist video data in the database.\n",
    "    \n",
    "    Args:\n",
    "        engine: SQLAlchemy engine\n",
    "        artist_results: Results from processing an artist's videos\n",
    "    \"\"\"\n",
    "    artist_name = artist_results['artist']\n",
    "    videos_data = artist_results.get('videos_data', [])\n",
    "    \n",
    "    logger.info(f\"Storing data for {artist_name}: {len(videos_data)} videos\")\n",
    "    \n",
    "    stored_count = 0\n",
    "    for video in videos_data:\n",
    "        try:\n",
    "            metadata = extract_video_metadata(video, artist_name)\n",
    "            store_video_data(engine, metadata)\n",
    "            stored_count += 1\n",
    "        except Exception as e:\n",
    "            logger.error(f\"Error storing video {video.get('id')}: {e}\")\n",
    "            continue\n",
    "    \n",
    "    logger.info(f\"Successfully stored {stored_count}/{len(videos_data)} videos for {artist_name}\")\n",
    "\n",
    "def create_database_summary(engine) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Create a summary of the YouTube data stored in the database.\n",
    "    \n",
    "    Args:\n",
    "        engine: SQLAlchemy engine\n",
    "    \n",
    "    Returns:\n",
    "        pd.DataFrame: Summary statistics\n",
    "    \"\"\"\n",
    "    query = \"\"\"\n",
    "    SELECT \n",
    "        channel_title as artist,\n",
    "        COUNT(*) as total_videos,\n",
    "        SUM(view_count) as total_views,\n",
    "        AVG(view_count) as avg_views,\n",
    "        MAX(view_count) as max_views,\n",
    "        MIN(view_count) as min_views,\n",
    "        SUM(like_count) as total_likes,\n",
    "        SUM(comment_count) as total_comments,\n",
    "        MAX(fetched_at) as last_updated\n",
    "    FROM youtube_videos\n",
    "    WHERE channel_title IN (\n",
    "        'BicFizzle', 'Cobrah', 'Corook', 'Enchanting', 'Flyana Boss'\n",
    "    )\n",
    "    GROUP BY channel_title\n",
    "    ORDER BY total_views DESC\n",
    "    \"\"\"\n",
    "    \n",
    "    try:\n",
    "        df = pd.read_sql_query(query, engine)\n",
    "        logger.info(f\"Created database summary with {len(df)} artists\")\n",
    "        return df\n",
    "    except Exception as e:\n",
    "        logger.error(f\"Error creating database summary: {e}\")\n",
    "        return pd.DataFrame()\n",
