    "def process_artist_videos(artist_name: str, artist_config: Dict, youtube) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Process all videos for a specific artist.\n",
    "    \n",
    "    Args:\n",
    "        artist_name: Name of the artist\n",
    "        artist_config: Configuration for the artist\n",
    "        youtube: YouTube API client\n",
    "    \n",
    "    Returns:\n",
    "        Dict: Processing results and statistics\n",
    "    \"\"\"\n",
    "    logger.info(f\"Processing videos for {artist_name}\")\n",
    "    \n",
    "    channel_id = artist_config['channel_id']\n",
    "    max_videos = CONFIG['max_videos_per_artist']\n",
    "    \n",
    "    # Get channel videos\n",
    "    videos = get_channel_videos(youtube, channel_id, max_videos)\n",
    "    if not videos:\n",
    "        logger.warning(f\"No videos found for {artist_name}\")\n",
    "        return {'artist': artist_name, 'videos_processed': 0, 'total_views': 0}\n",
    "    \n",
    "    # Extract video IDs for statistics\n",
    "    video_ids = [video['contentDetails']['videoId'] for video in videos]\n",
    "    \n",
    "    # Get video statistics in batches\n",
    "    all_video_stats = []\n",
    "    batch_size = CONFIG['batch_size']\n",
    "    \n",
    "    for i in range(0, len(video_ids), batch_size):\n",
    "        batch_ids = video_ids[i:i + batch_size]\n",
    "        logger.info(f\"Processing batch {i//batch_size + 1}/{(len(video_ids)-1)//batch_size + 1} for {artist_name}\")\n",
    "        \n",
    "        batch_stats = get_video_statistics(youtube, batch_ids)\n",
    "        all_video_stats.extend(batch_stats)\n",
    "        \n",
    "        # Small delay between batches to be respectful to the API\n",
    "        time.sleep(0.1)\n",
    "    \n",
    "    # Process and return results\n",
    "    results = {\n",
    "        'artist': artist_name,\n",
    "        'channel_id': channel_id,\n",
    "        'videos_processed': len(all_video_stats),\n",
    "        'videos_data': all_video_stats,\n",
    "        'total_views': sum(int(video.get('statistics', {}).get('viewCount', 0)) \n",
    "                          for video in all_video_stats if video.get('statistics'))\n",
    "    }\n",
    "    \n",
    "    logger.info(f\"Completed processing {len(all_video_stats)} videos for {artist_name}\")\n",
    "    return results\n",
    "\n",
    "def extract_video_metadata(video: Dict[str, Any], artist_name: str) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Extract and normalize metadata from a YouTube video.\n",
    "    \n",
    "    Args:\n",
    "        video: YouTube video data\n",
    "        artist_name: Name of the artist\n",
    "    \n",
    "    Returns:\n",
    "        Dict: Normalized video metadata\n",
    "    \"\"\"\n",
    "    snippet = video.get('snippet', {})\n",
    "    statistics = video.get('statistics', {})\n",
    "    content_details = video.get('contentDetails', {})\n",
    "    \n",
    "    # Parse title and extract artist info\n",
    "    title = snippet.get('title', '')\n",
    "    channel_title = snippet.get('channelTitle', '')\n",
    "    parsed_title = parse_youtube_title(title, channel_title)\n",
    "    \n",
    "    # Extract basic metadata\n",
    "    metadata = {\n",
    "        'video_id': video.get('id'),\n",
    "        'title': title,\n",
    "        'channel_title': channel_title,\n",
    "        'description': snippet.get('description', ''),\n",
    "        'published_at': snippet.get('publishedAt'),\n",
    "        'duration': content_details.get('duration', ''),\n",
    "        'view_count': int(statistics.get('viewCount', 0)),\n",
    "        'like_count': int(statistics.get('likeCount', 0)) if statistics.get('likeCount') else None,\n",
    "        'comment_count': int(statistics.get('commentCount', 0)) if statistics.get('commentCount') else None,\n",
    "        'tags': snippet.get('tags', []),\n",
    "        'artist_name': artist_name,\n",
    "        'parsed_title': parsed_title.get('title', ''),\n",
    "        'primary_artists': parsed_title.get('primary', []),\n",
    "        'featured_artists': parsed_title.get('featured', []),\n",
    "        'version_type': extract_version_type(title, channel_title),\n",
    "        'thumbnail_url': snippet.get('thumbnails', {}).get('high', {}).get('url', ''),\n",
    "        'fetched_at': datetime.now(timezone.utc)\n",
    "    }\n",
    "    \n",
    "    return metadata\n",
    "\n",
    "def calculate_artist_statistics(artist_results: List[Dict]) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Calculate aggregate statistics for all artists.\n",
    "    \n",
    "    Args:\n",
    "        artist_results: List of results for each artist\n",
    "    \n",
    "    Returns:\n",
    "        Dict: Aggregate statistics\n",
    "    \"\"\"\n",
    "    total_videos = sum(result['videos_processed'] for result in artist_results)\n",
    "    total_views = sum(result['total_views'] for result in artist_results)\n",
    "    \n",
    "    # Calculate per-artist averages\n",
    "    artist_stats = []\n",
    "    for result in artist_results:\n",
    "        videos = result['videos_processed']\n",
    "        views = result['total_views']\n",
    "        avg_views = views / videos if videos > 0 else 0\n",
    "        \n",
    "        artist_stats.append({\n",
    "            'artist': result['artist'],\n",
    "            'videos': videos,\n",
    "            'total_views': views,\n",
    "            'avg_views_per_video': round(avg_views, 2)\n",
    "        })\n",
    "    \n",
    "    return {\n",
    "        'total_artists': len(artist_results),\n",
    "        'total_videos': total_videos,\n",
    "        'total_views': total_views,\n",
    "        'avg_views_per_video': round(total_views / total_videos, 2) if total_videos > 0 else 0,\n",
    "        'artist_breakdown': artist_stats\n",
    "    }\n",
    "\n",
    "print(\"✅ Data processing functions defined!\")"
   ]
  },
