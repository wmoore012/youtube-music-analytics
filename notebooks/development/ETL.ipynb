    "def run_youtube_etl():\n",
    "    \"\"\"\n",
    "    Run the complete YouTube ETL pipeline.\n",
    "    \"\"\"\n",
    "    logger.info(\"🚀 Starting YouTube ETL Pipeline\")\n",
    "    start_time = time.time()\n",
    "    \n",
    "    try:\n",
    "        # Initialize YouTube API client\n",
    "        youtube = get_youtube_client()\n",
    "        logger.info(\"✅ YouTube API client initialized\")\n",
    "        \n",
    "        # Initialize database engine\n",
    "        engine = get_engine()\n",
    "        init_tables(engine)\n",
    "        ensure_dsp_rows(engine, ['YouTube'])\n",
    "        logger.info(\"✅ Database connection established\")\n",
    "        \n",
    "        # Process each artist\n",
    "        all_results = []\n",
    "        for artist_name, config in ARTISTS.items():\n",
    "            try:\n",
    "                logger.info(f\"\\n{'='*50}\")\n",
    "                logger.info(f\"🎤 Processing {artist_name}\")\n",
    "                logger.info(f\"{'='*50}\")\n",
    "                \n",
    "                artist_results = process_artist_videos(artist_name, config, youtube)\n",
    "                all_results.append(artist_results)\n",
    "                \n",
    "                # Store data in database\n",
    "                if artist_results.get('videos_data'):\n",
    "                    store_artist_data(engine, artist_results)\n",
    "                \n",
    "                # Progress update\n",
    "                logger.info(f\"✅ Completed {artist_name}: {artist_results['videos_processed']} videos, {artist_results['total_views']:,} total views\")\n",
    "                \n",
    "            except Exception as e:\n",
    "                logger.error(f\"❌ Error processing {artist_name}: {e}\")\n",
    "                continue\n",
    "        \n",
    "        # Calculate and display summary statistics\n",
    "        if all_results:\n",
    "            summary_stats = calculate_artist_statistics(all_results)\n",
    "            \n",
    "            logger.info(f\"\\n{'='*60}\")\n",
    "            logger.info(\"📊 ETL PIPELINE SUMMARY\")\n",
    "            logger.info(f\"{'='*60}\")\n",
    "            logger.info(f\"Total Artists Processed: {summary_stats['total_artists']}\")\n",
    "            logger.info(f\"Total Videos Extracted: {summary_stats['total_videos']:,}\")\n",
    "            logger.info(f\"Total Views Across All Videos: {summary_stats['total_views']:,}\")\n",
    "            logger.info(f\"Average Views Per Video: {summary_stats['avg_views_per_video']:,}\")\n",
    "            \n",
    "            logger.info(f\"\\n{'='*60}\")\n",
    "            logger.info(\"📈 PER-ARTIST BREAKDOWN\")\n",
    "            logger.info(f\"{'='*60}\")\n",
    "            for artist in summary_stats['artist_breakdown']:\n",
    "                logger.info(f\"{artist['artist']:<15} | Videos: {artist['videos']:<3} | Total Views: {artist['total_views']:,} | Avg/Views: {artist['avg_views_per_video']:,}\")\n",
    "            \n",
    "            # Create database summary\n",
    "            logger.info(f\"\\n{'='*60}\")\n",
    "            logger.info(\"💾 DATABASE SUMMARY\")\n",
    "            logger.info(f\"{'='*60}\")\n",
    "            db_summary = create_database_summary(engine)\n",
    "            if not db_summary.empty:\n",
    "                print(\"\\nDatabase Summary:\")\n",
    "                print(db_summary.to_string(index=False))\n",
    "        \n",
    "        # Calculate execution time\n",
    "        end_time = time.time()\n",
    "        execution_time = end_time - start_time\n",
    "        logger.info(f\"\\n⏱️  Total execution time: {execution_time:.2f} seconds\")\n",
    "        logger.info(\"✅ YouTube ETL Pipeline completed successfully!\")\n",
    "        \n",
    "        return {\n",
    "            'success': True,\n",
    "            'execution_time': execution_time,\n",
    "            'results': all_results,\n",
    "            'summary': summary_stats if all_results else None\n",
    "        }\n",
    "        \n",
    "    except Exception as e:\n",
    "        logger.error(f\"❌ ETL Pipeline failed: {e}\")\n",
    "        logger.error(\"Full traceback:\", exc_info=True)\n",
    "        return {\n",
    "            'success': False,\n",
    "            'error': str(e),\n",
    "            'execution_time': time.time() - start_time\n",
    "        }\n",
    "\n",
    "print(\"✅ Main ETL pipeline function defined!\")"
   ]
