    "\n",
    "def analyze_artist_trends(engine):\n",
    "    \"\"\"\n",
    "    Analyze trends by artist and year.\n",
    "    \"\"\"\n",
    "    query = \"\"\"\n",
    "    SELECT \n",
    "        channel_title as artist,\n",
    "        YEAR(published_at) as year,\n",
    "        COUNT(*) as videos_count,\n",
    "        SUM(view_count) as total_views,\n",
    "        AVG(view_count) as avg_views,\n",
    "        MAX(view_count) as max_views,\n",
    "        SUM(like_count) as total_likes,\n",
    "        SUM(comment_count) as total_comments\n",
    "    FROM youtube_videos\n",
    "    WHERE channel_title IN ('BicFizzle', 'Cobrah', 'Corook', 'Enchanting', 'Flyana Boss')\n",
    "    GROUP BY channel_title, YEAR(published_at)\n",
    "    ORDER BY artist, year\n",
    "    \"\"\"\n",
    "    \n",
    "    try:\n",
    "        df = pd.read_sql_query(query, engine)\n",
    "        return df\n",
