   "source": [
    "from youtubeviz.utils import filter_artists, safe_head\n",
    "from youtubeviz.charts import views_over_time_plotly, linked_scatter_detail_altair\n",
    "from youtubeviz.data import load_recent_window_days\n",
    "from web.etl_helpers import get_engine\n",
    "from IPython.display import display, Markdown\n",
    "# Setup Python path for imports\n",
    "import sys\n",
    "import os\n",
    "sys.path.append(os.path.abspath(\'.\'))\n",
    "sys.path.append(os.path.abspath(\'../..\'))\n",
    "\n",
    "import pandas as pd\n",
    "import altair as alt\n",
    "\n",
    "# Parameterize your five artists\n",
    "ARTISTS = [\n",
    "    # 'Artist A', 'Artist B', 'Artist C', 'Artist D', 'Artist E'\n",
    "]\n",
    "\n",
    "# Load last 90 days once (thin notebooks)\n",
    "engine = get_engine()\n",
    "F = load_recent_window_days(artists=ARTISTS or None, days=90, engine=engine)"
   ]
  },
