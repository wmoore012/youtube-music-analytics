   "source": [
    "# Derive top artists automatically when ARTISTS is empty\n",
    "if not ARTISTS:\n",
    "    TOP_N = 5\n",
    "    if not F.empty:\n",
    "        top = (F.groupby('artist_name', as_index=False)['views']\n",
    "                 .sum()\n",
    "                 .sort_values('views', ascending=False)\n",
    "                 .head(TOP_N))\n",
    "        ARTISTS = top['artist_name'].tolist()\n",
    "        msg = 'Auto-selected top ' + str(TOP_N) + ' artists by recent views: ' + ', '.join(ARTISTS)\n",
    "        display(Markdown(msg))\n",
    "    else:\n",
    "        display(Markdown('No recent data available to auto-select artists.'))\n"
   ]
  },
