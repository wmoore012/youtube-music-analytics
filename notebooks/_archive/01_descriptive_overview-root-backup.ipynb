   "source": [
    "## 📈 The Story Over Time: Momentum Analysis\n",
    "\n",
    "### Why Time Series Analysis Matters\n",
    "\n",
    "**Static numbers tell you where you are. Trends tell you where you're going.**\n",
    "\n",
    "This analysis reveals:\n",
    "- **🚀 Momentum patterns**: Which artists are gaining vs. losing steam\n",
    "- **📅 Seasonal effects**: Do certain times drive more engagement?\n",
    "- **🎬 Release impact**: How new content affects overall performance\n",
    "- **⚡ Viral moments**: Sudden spikes that indicate breakout content"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f934e8bd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 📈 Momentum and trend analysis\n",
    "print(\"📈 Analyzing momentum patterns...\")\n",
    "\n",
    "# Calculate momentum metrics\n",
    "momentum_stats = []\n",
    "for artist in ARTISTS:\n",
    "    artist_data = df[df['artist_name'] == artist].copy()\n",
    "    if len(artist_data) > 14:  # Need enough data\n",
    "        # Sort by date\n",
    "        artist_data = artist_data.sort_values('date')\n",
    "        \n",
    "        # Calculate trend (recent vs early performance)\n",
    "        recent_avg = artist_data['views'].tail(14).mean()  # Last 2 weeks\n",
    "        early_avg = artist_data['views'].head(14).mean()   # First 2 weeks\n",
    "        trend_change = ((recent_avg - early_avg) / early_avg * 100) if early_avg > 0 else 0\n",
    "        \n",
    "        # Peak performance days\n",
    "        peak_threshold = artist_data['views'].quantile(0.9)\n",
    "        peak_days = len(artist_data[artist_data['views'] > peak_threshold])\n",
    "        \n",
    "        # Volatility\n",
    "        volatility = artist_data['views'].std() / artist_data['views'].mean() if artist_data['views'].mean() > 0 else 0\n",
    "        \n",
    "        momentum_stats.append({\n",
    "            'artist_name': artist,\n",
    "            'trend_change_pct': round(trend_change, 1),\n",
    "            'recent_avg_views': round(recent_avg, 0),\n",
    "            'peak_days': peak_days,\n",
    "            'volatility': round(volatility, 2)\n",
    "        })\n",
    "\n",
    "if momentum_stats:\n",
    "    momentum_df = pd.DataFrame(momentum_stats)\n",
    "    \n",
    "    print(\"\\n🚀 MOMENTUM ANALYSIS:\")\n",
    "    display(momentum_df)\n",
    "    \n",
    "    # Investment recommendations based on momentum\n",
    "    print(\"\\n💰 MARKETING INVESTMENT RECOMMENDATIONS:\")\n",
    "    for _, row in momentum_df.iterrows():\n",
    "        if row['trend_change_pct'] > 20:\n",
    "            rec = \"🟢 INCREASE BUDGET (Strong upward momentum)\"\n",
    "        elif row['trend_change_pct'] > 0:\n",
    "            rec = \"🟡 MAINTAIN/TEST INCREASE (Positive momentum)\"\n",
    "        elif row['trend_change_pct'] > -20:\n",
    "            rec = \"⚪ MONITOR CLOSELY (Stable/slight decline)\"\n",
    "        else:\n",
    "            rec = \"🔴 INVESTIGATE STRATEGY (Significant decline)\"\n",
    "        print(f\"   {row['artist_name']}: {rec}\")\n",
    "\n",
    "# 📊 Create visualization\n",
    "print(\"\\n📊 Generating interactive trend visualization...\")\n",
    "df_sorted = df.sort_values('date').copy()\n",
    "df_sorted['month'] = df_sorted['date'].dt.to_period('M').astype(str)\n",
    "COLOR_MAP = get_artist_color_map(ARTISTS)\n",
    "\n",
    "fig = views_over_time_plotly(\n",
    "    df_sorted, \n",
    "    date_col='date',\n",
    "    value_col='views',\n",
    "    group_col='artist_name',\n",
    "    hover_col='video_title',\n",
    "    animate_by='month',\n",
    "    color_map=COLOR_MAP\n",
    ")\n",
    "\n",
    "if fig:\n",
    "    fig.update_layout(\n",
    "        title='📈 Artist Performance Over Time<br><sub>Daily views with monthly animation</sub>',\n",
    "        height=600\n",
    "    )\n",
    "    fig.show()\n",
    "\n",
    "print(\"\\n✅ Momentum analysis complete!\")"
   ]
  },
