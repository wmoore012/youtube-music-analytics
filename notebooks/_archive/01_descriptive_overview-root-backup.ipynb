   "id": "bbf89e65",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🎨 Artist Selection (Customize This!)\n",
    "# Leave empty to use all available artists, or specify names like:\n",
    "ARTISTS = [\n",
    "    # 'Artist Name 1', 'Artist Name 2', etc.\n",
    "]\n",
    "\n",
    "# 🔌 Connect to database\n",
    "print(\"🔌 Connecting to database...\")\n",
    "engine = get_engine()\n",
    "\n",
    "# 💰 Load revenue settings\n",
    "RPM_DEFAULT, RPM_MAP = read_rpm_from_env()\n",
    "print(f\"💰 Revenue model: ${RPM_DEFAULT} per 1,000 views\")\n",
    "\n",
    "# 📊 Load data\n",
    "print(\"📊 Loading last 90 days of performance data...\")\n",
    "df = load_recent_window_days(artists=ARTISTS, days=90, engine=engine)\n",
    "\n",
    "# 🎤 Select artists to analyze\n",
    "if not ARTISTS:\n",
    "    available_artists = df['artist_name'].unique()\n",
    "    ARTISTS = list(available_artists[:5])  # Take first 5\n",
    "    print(f\"🎤 Analyzing available artists: {', '.join(ARTISTS)}\")\n",
    "else:\n",
    "    df = df[df['artist_name'].isin(ARTISTS)]\n",
    "    print(f\"🎤 Analyzing selected artists: {', '.join(ARTISTS)}\")\n",
    "\n",
    "# 📈 Dataset summary\n",
    "print(f\"\\n📈 DATASET SUMMARY:\")\n",
    "print(f\"   📊 Records: {len(df):,}\")\n",
    "print(f\"   🎤 Artists: {df['artist_name'].nunique()}\")\n",
    "print(f\"   🎵 Videos: {df['video_id'].nunique()}\")\n",
    "print(f\"   📅 Date range: {df['date'].min()} to {df['date'].max()}\")\n",
    "print(f\"   👀 Total views: {df['views'].sum():,}\")\n",
    "\n",
    "# 🔍 Preview the data\n",
    "print(\"\\n🔍 DATA PREVIEW:\")\n",
    "display(safe_head(df, ['artist_name', 'video_title', 'date', 'views'], 10))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f84da2c1",
   "metadata": {},
   "source": [
    "## 📊 The Executive Summary: Key Performance Indicators\n",
    "\n",
    "### Why These Metrics Matter in the Music Industry\n",
    "\n",
    "**Think of this as your \"artist health check\" — the vital signs that tell you who's thriving and who needs attention.**\n",
    "\n",
    "#### 🔍 What Each Metric Reveals:\n",
    "\n",
    "- **📹 Total Videos**: *Catalog depth* — more content = more opportunities for discovery\n",
    "- **👀 Total Views**: *Reach and popularity* — the raw audience size each artist commands\n",
    "- **📊 Median Views**: *Typical performance* — what a \"normal\" video does (not skewed by viral hits)\n",
    "- **📈 Mean Views**: *Average performance* — includes the impact of breakout successes\n",
    "- **🎯 Mode Views**: *Most common result* — the view count that appears most frequently\n",
    "\n",
    "#### 💡 Pro Tip: Reading the Numbers\n",
    "- **Mean > Median**: Artist has some viral hits pulling the average up\n",
    "- **Mean ≈ Median**: Consistent performance across videos\n",
    "- **Large gap between Mean and Mode**: A few massive hits, many smaller videos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "86e623bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🧮 Calculate comprehensive KPIs\n",
    "print(\"🧮 Computing key performance indicators...\")\n",
    "kpis = compute_kpis(df)\n",
    "\n",
    "# 🎨 Format for better readability\n",
    "kpis_display = kpis.copy()\n",
    "for col in ['total_views', 'median_views', 'mean_views', 'mode_views']:\n",
    "    if col in kpis_display.columns:\n",
    "        kpis_display[col] = kpis_display[col].apply(lambda x: f\"{x:,.0f}\")\n",
    "\n",
    "print(\"\\n🏆 ARTIST PERFORMANCE SCORECARD\")\n",
    "print(\"=\" * 50)\n",
    "display(kpis_display)\n",
    "\n",
    "# 📝 Generate insights\n",
    "if len(kpis) > 0:\n",
    "    top_performer = kpis.loc[kpis['total_views'].idxmax(), 'artist_name']\n",
    "    most_consistent = kpis.loc[(kpis['mean_views'] - kpis['median_views']).abs().idxmin(), 'artist_name']\n",
    "    most_prolific = kpis.loc[kpis['videos'].idxmax(), 'artist_name']\n",
    "    \n",
    "    print(f\"\\n🎯 QUICK INSIGHTS:\")\n",
    "    print(f\"👑 Reach Leader: {top_performer} (highest total views)\")\n",
    "    print(f\"🎯 Most Consistent: {most_consistent} (mean ≈ median views)\")\n",
    "    print(f\"🎵 Most Prolific: {most_prolific} (most videos in period)\")\n",
    "    \n",
    "    # Market share analysis\n",
    "    total_market = kpis['total_views'].sum()\n",
    "    print(f\"\\n📊 MARKET SHARE BREAKDOWN:\")\n",
    "    for _, row in kpis.sort_values('total_views', ascending=False).iterrows():\n",
    "        share = (row['total_views'] / total_market * 100)\n",
    "        print(f\"   {row['artist_name']}: {share:.1f}%\")\n",
    "\n",
    "print(\"\\n✅ KPI analysis complete!\")"
   ]
  },
