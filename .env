# 🤖 AI Sentiment Analysis Configuration 🤖
SENTIMENT_USE_ML_MODELS=false           # 🧠 Use advanced ML models
SENTIMENT_VADER_WEIGHT=0.7              # ⚖️ VADER algorithm weight
SENTIMENT_ML_WEIGHT=0.3                 # 🤖 ML model weight
SENTIMENT_ENABLE_SARCASM_DETECTION=true # 😏 Detect sarcasm in comments
SENTIMENT_MUSIC_CONTEXT_BOOST=1.2       # 🎵 Music-specific sentiment boost
SENTIMENT_ENABLE_CUSTOM_LEXICONS=true   # 📚 Use music industry lexicons

# 🛡️ Bot Detection & Comment Quality Control 🛡️
BOT_DETECTION_ENABLED=true              # 🤖 Enable bot detection analysis
BOT_DETECTION_THRESHOLD=0.85            # 🎯 Bot confidence threshold (0.0-1.0)
BOT_DETECTION_DAYS_LOOKBACK=30          # 📅 Days of comments to analyze for patterns
BOT_WHITELIST_ENABLED=true              # ✅ Enable whitelist for legitimate fan phrases
BOT_ANALYSIS_IN_NOTEBOOKS=true          # 📊 Include bot analysis in notebooks
# Note: We analyze and flag bots but NEVER delete comments - data integrity first!

# ⚡ ETL Pipeline Performance Settings ⚡
ETL_BATCH_SIZE=50                       # 📦 Records per batch
ETL_ENABLE_CACHING=true                 # 💾 Enable data caching
ETL_LOG_LEVEL=INFO                      # 📝 Logging verbosity

