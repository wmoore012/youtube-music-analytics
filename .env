# 🏷️ YOUTUBE TOPIC CHANNELS (Official releases, auto-generated by YouTube)
# These channels contain official music releases distributed through record labels
# Format: YT_ARTISTNAME_TOPIC_YT=Channel_ID (use Channel ID for Topic channels!)
#
# 💡 TO FIND TOPIC CHANNEL IDs:
# 1. Search "Artist Name - Topic" on YouTube
# 2. Use: python tools/utilities/find_channel_id.py "Artist Name - Topic"
# 3. Verify the channel has official releases before adding
#
# 🚨 IMPORTANT: Only add Topic channels if they exist and have official content!
# Not all artists have Topic channels - they're auto-generated when music is distributed

# YT_BICFIZZLE_TOPIC_YT=UC_REPLACE_WITH_ACTUAL_TOPIC_CHANNEL_ID
# YT_COBRAH_TOPIC_YT=UC_REPLACE_WITH_ACTUAL_TOPIC_CHANNEL_ID
# YT_COROOK_TOPIC_YT=UC_REPLACE_WITH_ACTUAL_TOPIC_CHANNEL_ID
# YT_RAICHE_TOPIC_YT=UC_REPLACE_WITH_ACTUAL_TOPIC_CHANNEL_ID
# YT_RE6CE_TOPIC_YT=UC_REPLACE_WITH_ACTUAL_TOPIC_CHANNEL_ID
# YT_FLYANABOSS_TOPIC_YT=UC_REPLACE_WITH_ACTUAL_TOPIC_CHANNEL_ID

