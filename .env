# 🎯 Analysis Configuration 🎯
# What type of content are you analyzing? This affects cleanup behavior and data quality flags
# 🎵 music_artists: Focus on music artists, remove non-artist content (podcasts, business channels)
# 🎙️ podcasts: Focus on podcast content, optimize for talk shows and interviews
# 🎭 mixed: Analyze both music and podcast content together
# 🌐 general: Analyze any type of YouTube content without specific focus
CHANNEL_ANALYSIS_TYPE=music_artists

# 📊 Analysis Parameters 📊
MOMENTUM_THRESHOLD_DAYS=30              # 📈 Days to analyze for momentum trends
GROWTH_RATE_MINIMUM=0.05               # 📊 Minimum growth rate to flag as significant
SENTIMENT_CONFIDENCE_THRESHOLD=0.7     # 🎯 Confidence threshold for sentiment analysis
REVENUE_RPM_DEFAULT=2.50               # 💰 Default revenue per mille for estimates

# 🎨 Artist Color Mapping (For Consistent Visualizations) 🎨
# Each artist gets a unique color for charts and graphs
# 🔵 Blue: BiC Fizzle (Cool and confident)
# 🟠 Orange: COBRAH (Bold and energetic)
# 🟢 Green: Flyana Boss (Fresh and vibrant)
# 🔴 Red: Raiche (Passionate and strong)
# 🟣 Purple: re6ce (Creative and unique)
ARTIST_COLORS_JSON={"BiC Fizzle": "#1f77b4", "COBRAH": "#ff7f0e", "Flyana Boss": "#2ca02c", "Raiche": "#d62728", "re6ce": "#9467bd"}

# 🎨 Visualization Settings 🎨
ARTIST_COLOR_SCHEME=vibrant             # 🌈 Color scheme: vibrant, pastel, monochrome
DEFAULT_CHART_HEIGHT=600                # 📏 Default chart height in pixels
MAX_ARTISTS_PER_CHART=10               # 👥 Maximum artists to show per chart

# ⚖️ YouTube Terms of Service Compliance ⚖️
# YouTube requires deletion of user data after specified retention period
YOUTUBE_DATA_RETENTION_DAYS=30          # 📅 General data retention (30 days per TOS)
YOUTUBE_COMMENT_RETENTION_DAYS=30       # 💬 Comment retention period
YOUTUBE_METRICS_RETENTION_DAYS=365      # 📊 Keep metrics longer for trend analysis
YOUTUBE_TOS_COMPLIANCE_ENABLED=true     # ✅ Enable automatic compliance cleanup

# 🔄 ETL Pipeline Control & Execution Mode 🔄
# Choose how your ETL pipeline behaves based on how you're running it

ETL_RUN_TYPE=manual                     # 🎮 Current execution mode

# 🎮 manual: Interactive runs with full output and user feedback
#    - Use when: Running ETL manually from command line
#    - Behavior: Detailed logging, progress indicators, user-friendly output
#    - Example: python tools/etl/run_focused_etl.py

# 🤖 cron: Automated scheduled runs optimized for background execution
#    - Use when: Running from cron jobs or automated systems
#    - Behavior: Minimal output, structured logging, error alerts only
#    - Example: Daily 2 AM automated runs via cron

# 🏭 automated: CI/CD and production deployment runs
#    - Use when: Running from GitHub Actions, Docker, or deployment scripts
#    - Behavior: JSON output, comprehensive logging, deployment-ready format
#    - Example: Production deployment pipelines

# 💡 Pro tip: The system automatically detects the environment and adjusts behavior accordingly!
