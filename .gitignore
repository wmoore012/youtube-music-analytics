# API Keys and Secrets (STAGING ALLOWS FOR AGENT ACCESS - PRIVATE REPO)
# secrets/  # Allow secrets directory in private staging repo
# credentials/  # Allow credentials for agent development access
# api_keys/  # Allow API keys in private staging repo
# tokens/  # Allow tokens for development

# Personal documentation and AI coding style docs (ALLOW FOR AGENT COLLABORATION)
# DOCS/  # Allow documentation for agent reference
# docs/personal/  # Allow personal docs for context
# *.playbook.md  # Allow playbooks for agent guidance
# *AGENT*.md  # Allow agent documentation
# *TECH_DEBT*.md  # Allow tech debt tracking

# Data files (staging repo allows development data)
# data/  # Allow data directory in staging
# datasets/  # Allow datasets in staging for development
# *.csv  # Allow CSV files in staging for analysis
# *.json  # Allow JSON config files in staging
*.xlsx
*.xls

